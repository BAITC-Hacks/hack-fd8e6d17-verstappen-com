# Скопируйте в .env (в корне репозитория) и заполните. Файл .env в git не попадает.

# Ключ OpenAI. Пусто — ИИ работает на заглушке по правилам (mode: "mock").
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# База данных. Закомментируйте строку — будет SQLite (backend/data/app.db), без настройки.
# С PostgreSQL run.sh / run.ps1 сам поднимет контейнер из docker-compose.yml (нужен Docker Desktop).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hacksana

# Для контейнера PostgreSQL. Должны совпадать с DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hacksana

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Защита POST /api/admin/reset (заголовок X-Admin-Token). На публичном сервере обязательно.
ADMIN_TOKEN=
